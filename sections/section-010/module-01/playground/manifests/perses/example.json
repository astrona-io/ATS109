{
  "kind": "Dashboard",
  "metadata": {
    "name": "example",
    "project": "specs"
  },
  "spec": {
    "display": {
      "name": "Example: Prometheus At A Glance"
    },
    "duration": "1h",
    "variables": [],
    "panels": {
      "targets": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Targets up"
          },
          "plugin": {
            "kind": "StatChart",
            "spec": {
              "calculation": "last-number",
              "format": {
                "unit": "decimal"
              }
            }
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "sum(up)",
                    "datasource": {
                      "kind": "PrometheusDatasource",
                      "name": "prometheus"
                    }
                  }
                }
              }
            }
          ]
        }
      },
      "requests": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Request rate"
          },
          "plugin": {
            "kind": "TimeSeriesChart",
            "spec": {
              "legend": {
                "position": "bottom"
              },
              "yAxis": {
                "format": {
                  "unit": "requests/sec"
                }
              }
            }
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "sum by (handler) (rate(prometheus_http_requests_total[5m]))",
                    "datasource": {
                      "kind": "PrometheusDatasource",
                      "name": "prometheus"
                    },
                    "seriesNameFormat": "{{handler}}"
                  }
                }
              }
            }
          ]
        }
      }
    },
    "layouts": [
      {
        "kind": "Grid",
        "spec": {
          "display": {
            "title": "Overview",
            "collapse": {
              "open": true
            }
          },
          "items": [
            {
              "x": 0,
              "y": 0,
              "width": 6,
              "height": 6,
              "content": {
                "$ref": "#/spec/panels/targets"
              }
            },
            {
              "x": 6,
              "y": 0,
              "width": 18,
              "height": 6,
              "content": {
                "$ref": "#/spec/panels/requests"
              }
            }
          ]
        }
      }
    ],
    "refreshInterval": "1m"
  }
}
