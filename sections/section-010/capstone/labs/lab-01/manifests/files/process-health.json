{
  "kind": "Dashboard",
  "metadata": {
    "name": "process-health",
    "project": "capstone"
  },
  "spec": {
    "display": {
      "name": "Process Health"
    },
    "duration": "1h",
    "variables": [],
    "panels": {
      "mem": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Resident memory"
          },
          "plugin": {
            "kind": "StatChart",
            "spec": {
              "calculation": "average",
              "format": {
                "unit": "bytes"
              }
            }
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "process_resident_memory_bytes",
                    "datasource": {
                      "kind": "PrometheusDatasource",
                      "name": "prometheus"
                    }
                  }
                }
              }
            }
          ]
        }
      },
      "cpu": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "CPU usage"
          },
          "plugin": {
            "kind": "TimeSeriesChart",
            "spec": {
              "yAxis": {
                "format": {
                  "unit": "seconds"
                }
              }
            }
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "rate(process_cpu_seconds_total[5m])",
                    "datasource": {
                      "kind": "PrometheusDatasource",
                      "name": "prom-main"
                    },
                    "seriesNameFormat": "{{job}}"
                  }
                }
              }
            }
          ]
        }
      },
      "fds": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Open file descriptors"
          },
          "plugin": {
            "kind": "StatChart",
            "spec": {
              "calculation": "last-number",
              "format": {
                "unit": "decimal"
              }
            }
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "process_open_fd",
                    "datasource": {
                      "kind": "PrometheusDatasource",
                      "name": "prometheus"
                    }
                  }
                }
              }
            }
          ]
        }
      }
    },
    "layouts": [
      {
        "kind": "Grid",
        "spec": {
          "display": {
            "title": "Process",
            "collapse": {
              "open": true
            }
          },
          "items": [
            {
              "x": 0,
              "y": 0,
              "width": 8,
              "height": 6,
              "content": {
                "$ref": "#/spec/panels/memory"
              }
            },
            {
              "x": 8,
              "y": 0,
              "width": 16,
              "height": 6,
              "content": {
                "$ref": "#/spec/panels/cpu"
              }
            },
            {
              "x": 0,
              "y": 6,
              "width": 8,
              "height": 6,
              "content": {
                "$ref": "#/spec/panels/fds"
              }
            }
          ]
        }
      }
    ]
  }
}
