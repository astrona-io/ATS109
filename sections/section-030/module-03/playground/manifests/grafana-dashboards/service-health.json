          "datasource": {
            "type": "prometheus",
            "uid": "prom-main"
          },
          "expr": "process_resident_memory_bytes{job=\"prometheus\"}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
