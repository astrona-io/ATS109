{
  "kind": "Dashboard",
  "metadata": {
    "name": "service-health",
    "project": "release"
  },
  "spec": {
    "display": {
      "name": "Service Health"
    },
    "duration": "6h",
    "refreshInterval": "30s",
    "panels": {
      "0": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Memory"
          },
          "plugin": {
            "kind": "StatChart",
            "spec": {
              "calculation": "last-number",
              "format": {
                "unit": "bytes"
              }
            }
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "process_resident_memory_bytes{job=\"prometheus\"}"
                  }
                }
              }
            }
          ]
        }
      },
      "1": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Goroutines"
          },
          "plugin": {
            "kind": "TimeSeriesChart",
            "spec": {
              "yAxis": {
                "format": {
                  "unit": "decimal"
                }
              }
            }
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "go_threads{job=\"prometheus\"}"
                  }
                }
              }
            }
          ]
        }
      },
      "2": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Open files"
          },
          "plugin": {
            "kind": "StatChart",
            "spec": {
              "calculation": "last-number",
              "format": {
                "unit": "decimal"
              }
            }
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "process_open_fds{job=\"prometheus\"}"
                  }
                }
              }
            }
          ]
        }
      },
      "3": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "CPU"
          },
          "plugin": {
            "kind": "TimeSeriesChart",
            "spec": {
              "yAxis": {
                "format": {
                  "unit": "decimal"
                }
              }
            }
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "rate(process_cpu_seconds_total{job=\"prometheus\"}[$__rate_interval])"
                  }
                }
              }
            }
          ]
        }
      },
      "4": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Head series"
          },
          "plugin": {
            "kind": "StatChart",
            "spec": {
              "calculation": "last-number",
              "format": {
                "unit": "decimal"
              }
            }
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "prometheus_tsdb_head_series"
                  }
                }
              }
            }
          ]
        }
      }
    },
    "layouts": [
      {
        "kind": "Grid",
        "spec": {
          "display": {
            "title": "Panel Group 1",
            "collapse": {
              "open": true
            }
          },
          "items": [
            {
              "x": 0,
              "y": 0,
              "width": 6,
              "height": 6,
              "content": {
                "$ref": "#/spec/panels/0"
              }
            },
            {
              "x": 6,
              "y": 0,
              "width": 18,
              "height": 6,
              "content": {
                "$ref": "#/spec/panels/1"
              }
            },
            {
              "x": 0,
              "y": 6,
              "width": 6,
              "height": 6,
              "content": {
                "$ref": "#/spec/panels/2"
              }
            },
            {
              "x": 6,
              "y": 6,
              "width": 18,
              "height": 6,
              "content": {
                "$ref": "#/spec/panels/3"
              }
            },
            {
              "x": 0,
              "y": 12,
              "width": 6,
              "height": 6,
              "content": {
                "$ref": "#/spec/panels/4"
              }
            }
          ]
        }
      }
    ]
  }
}
